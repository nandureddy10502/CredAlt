# CredAlt Primary Backend Configuration

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example: mongodb://127.0.0.1:27017/credalt OR mongodb+srv://<user>:<password>@cluster.mongodb.net/credalt
MONGODB_URI=mongodb://127.0.0.1:27017/credalt

# JWT Secret for Session Signing (change to a cryptographically secure random string in production)
JWT_SECRET=credalt_jwt_secret_replace_with_strong_random_key

# FastApi ML Microservice URL
ML_SERVICE_URL=http://127.0.0.1:8000
FASTAPI_URL=http://127.0.0.1:8000

# Allowed Frontend Client Origin(s) for CORS (comma-separated for multiples)
CLIENT_URL=http://localhost:5173
